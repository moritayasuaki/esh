; Both branches contribute to the static effect bound.
(script
  (cap workspace (read write))
  (returns (Result Unit FsError))
  (effects (fs.read workspace) (fs.write workspace))

  (do
    (let mode-path (path "mode.txt"))
    (let target (path "result.txt"))
    (let-ok mode (fs.read-text workspace mode-path))
    (let enabled (text.eq mode "write"))
    (if enabled
      (do (fs.write-text workspace target "enabled\n"))
      (do (ok unit)))))
